APP_NAME="NiroNex"
BRAND_THEME=nironex
BRAND_TAGLINE="AI-Powered Trading. Smarter Profits."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nironex.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Damascus

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_USERNAME
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.nironex.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.nironex.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@nironex.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
REFER_PERCENT=0.06

USDTTRC20=CHANGE_ME_TRC20_WALLET
USDTERC20=CHANGE_ME_ERC20_WALLET
SHAMCASH_ACCOUNT=

CHAT_EMAIL=chat@nironex.com
SUPPORT_EMAIL=support@nironex.com
WHATSAPP_NUMBER=CHANGE_ME_WHATSAPP_NUMBER

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
